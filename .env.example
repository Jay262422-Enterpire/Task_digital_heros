# Prisma is PostgreSQL only (Supabase on Vercel). SQLite file: URLs no longer work.
# Local: a Postgres instance OR the same Supabase URIs.
# DATABASE_URL = transaction pooler (port 6543) on Vercel; local can be the same
#                Postgres URL for both if you are not using PgBouncer.
# DIRECT_URL   = direct Postgres (port 5432, host db.<ref>.supabase.co)
DATABASE_URL=""
DIRECT_URL=""

# JWT / session-cookie signing for `dh_session`. Not a Stripe or Supabase key.
# Generate: openssl rand -base64 32
AUTH_SECRET=""

# Stripe Checkout (test mode). Checkout is not mocked: missing keys show an error
# and never activate a plan. Publishable key is optional (hosted Checkout redirect
# does not need Stripe.js).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Optional. Used for Checkout success/cancel URLs if the request host is unavailable.
# APP_URL="https://task-digital-heros-bice.vercel.app"
